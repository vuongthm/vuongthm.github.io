{
  "name": "vuongthm-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "pipeline": "node scripts/pipeline.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:network": "node scripts/dev.mjs --network",
    "dev:stop": "node scripts/dev-stop.mjs",
    "build": "node scripts/pipeline.mjs && next build && node scripts/check-artifact.mjs",
    "start": "node scripts/preview.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write app components lib scripts styles",
    "vault:init": "node scripts/vault/init.mjs",
    "vault:build": "node scripts/vault/build.mjs",
    "content": "node scripts/pipeline.mjs",
    "content:new": "node scripts/content/new.mjs",
    "content:password": "node scripts/content/password.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fuse.js": "^7.4.2",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.16.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5",
    "prettier": "^3.9.10",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vitest": "^3",
    "yaml": "^2.6.0"
  },
  "packageManager": "pnpm@9.15.4"
}
